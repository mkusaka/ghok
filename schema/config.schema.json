{
  "$id": "https://raw.githubusercontent.com/mkusaka/ghok/main/schema/config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "hooks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "captureOutput": {
            "description": "Post hooks only: include gh stdout/stderr (base64, bounded) in the hook input.",
            "type": "boolean"
          },
          "command": {
            "description": "Executable and arguments; relative paths resolve against the config file directory.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "dependsOn": {
            "description": "IDs of hooks (same phase) that must finish first.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "enabled": {
            "type": "boolean"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "match": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "description": "gh command path prefixes such as \"pr merge\" or \"api\".",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "effect": {
                "oneOf": [
                  {
                    "enum": [
                      "read",
                      "write",
                      "unknown"
                    ],
                    "type": "string"
                  },
                  {
                    "items": {
                      "enum": [
                        "read",
                        "write",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "exitCode": {
                "description": "Post hooks only: gh exit codes (0-255) to run for.",
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              "hosts": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "level": {
                "description": "L1 native gh command, L2 gh api REST call, L3 gh api graphql call.",
                "oneOf": [
                  {
                    "enum": [
                      "L1",
                      "L2",
                      "L3",
                      "none"
                    ],
                    "type": "string"
                  },
                  {
                    "items": {
                      "enum": [
                        "L1",
                        "L2",
                        "L3",
                        "none"
                      ],
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "operation": {
                "description": "Action globs such as pr.merge.* (see docs/normalization.md).",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "repositories": {
                "description": "owner/repo globs (case-insensitive).",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "result": {
                "description": "Post hooks only: success = gh exited 0; failure = non-zero exit, killed by a signal, or gh could not be started.",
                "oneOf": [
                  {
                    "enum": [
                      "success",
                      "failure"
                    ],
                    "type": "string"
                  },
                  {
                    "items": {
                      "enum": [
                        "success",
                        "failure"
                      ],
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "token": {
                "description": "Kind of token in GH_TOKEN/GITHUB_TOKEN: app (ghs_, GitHub App installation, e.g. gain or Actions), user (ghp_/gho_/ghu_/github_pat_), unknown (other value), none (not set: gh's stored login).",
                "oneOf": [
                  {
                    "enum": [
                      "app",
                      "user",
                      "unknown",
                      "none"
                    ],
                    "type": "string"
                  },
                  {
                    "items": {
                      "enum": [
                        "app",
                        "user",
                        "unknown",
                        "none"
                      ],
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              }
            },
            "type": "object"
          },
          "maxOutputBytes": {
            "type": "integer"
          },
          "onError": {
            "enum": [
              "deny",
              "allow",
              "ignore"
            ],
            "type": "string"
          },
          "optional": {
            "description": "Skip instead of failing when the command is missing or not executable.",
            "type": "boolean"
          },
          "phase": {
            "enum": [
              "pre",
              "post"
            ],
            "type": "string"
          },
          "priority": {
            "description": "Lower runs first; ties keep config order.",
            "type": "integer"
          },
          "timeout": {
            "description": "Go duration, e.g. 10s.",
            "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "phase",
          "command"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "logging": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "level": {
          "enum": [
            "info",
            "decision"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "observe: classify and log only; enforce: deny according to rules, unknown handling and pre-hooks.",
          "enum": [
            "observe",
            "enforce"
          ],
          "type": "string"
        },
        "protectedRepositories": {
          "description": "owner/repo globs; unclassified or unresolved writes against them use protectedUnknown.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protectedUnknown": {
          "description": "Handling of unclassified/unresolved writes that may target a protected repository.",
          "enum": [
            "allow",
            "deny",
            "audit"
          ],
          "type": "string"
        },
        "rules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "decision": {
                "enum": [
                  "deny",
                  "audit"
                ],
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "match": {
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "description": "gh command path prefixes such as \"pr merge\" or \"api\".",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "effect": {
                    "oneOf": [
                      {
                        "enum": [
                          "read",
                          "write",
                          "unknown"
                        ],
                        "type": "string"
                      },
                      {
                        "items": {
                          "enum": [
                            "read",
                            "write",
                            "unknown"
                          ],
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "exitCode": {
                    "description": "Post hooks only: gh exit codes (0-255) to run for.",
                    "items": {
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  "hosts": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "level": {
                    "description": "L1 native gh command, L2 gh api REST call, L3 gh api graphql call.",
                    "oneOf": [
                      {
                        "enum": [
                          "L1",
                          "L2",
                          "L3",
                          "none"
                        ],
                        "type": "string"
                      },
                      {
                        "items": {
                          "enum": [
                            "L1",
                            "L2",
                            "L3",
                            "none"
                          ],
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "operation": {
                    "description": "Action globs such as pr.merge.* (see docs/normalization.md).",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "repositories": {
                    "description": "owner/repo globs (case-insensitive).",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "result": {
                    "description": "Post hooks only: success = gh exited 0; failure = non-zero exit, killed by a signal, or gh could not be started.",
                    "oneOf": [
                      {
                        "enum": [
                          "success",
                          "failure"
                        ],
                        "type": "string"
                      },
                      {
                        "items": {
                          "enum": [
                            "success",
                            "failure"
                          ],
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "token": {
                    "description": "Kind of token in GH_TOKEN/GITHUB_TOKEN: app (ghs_, GitHub App installation, e.g. gain or Actions), user (ghp_/gho_/ghu_/github_pat_), unknown (other value), none (not set: gh's stored login).",
                    "oneOf": [
                      {
                        "enum": [
                          "app",
                          "user",
                          "unknown",
                          "none"
                        ],
                        "type": "string"
                      },
                      {
                        "items": {
                          "enum": [
                            "app",
                            "user",
                            "unknown",
                            "none"
                          ],
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  }
                },
                "type": "object"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "decision"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "unknownMutation": {
          "description": "Handling of write/unknown operations that could not be classified.",
          "enum": [
            "allow",
            "deny",
            "audit"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "captureLimit": {
          "type": "integer"
        },
        "fileMaxBytes": {
          "type": "integer"
        },
        "hookConcurrency": {
          "type": "integer"
        },
        "realGh": {
          "description": "Absolute path of the real gh; discovered on PATH when empty.",
          "type": "string"
        },
        "resolveTimeout": {
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "type": "string"
        },
        "stdinMaxBytes": {
          "type": "integer"
        },
        "stdinTimeout": {
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "trust": {
      "additionalProperties": false,
      "deprecated": true,
      "description": "Deprecated and ignored. Use ghok config trust to authorize project hooks by file content.",
      "properties": {
        "projects": {
          "deprecated": true,
          "description": "Deprecated and ignored. Run ghok config trust [PATH]; any edit to .ghok.yaml requires re-trust.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "version": {
      "description": "Config format version; must be 1.",
      "enum": [
        1
      ],
      "type": "integer"
    }
  },
  "title": "ghok config.yaml",
  "type": "object"
}
